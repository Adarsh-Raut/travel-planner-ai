{
  "name": "travel-planner-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the AI Travel Planner",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
