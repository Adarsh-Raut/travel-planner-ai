# Server runtime
PORT=8000
NODE_ENV=development

# MongoDB (chunk 0.3)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# LLM providers (chunk 3)
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Auth
# Generate a secret with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
